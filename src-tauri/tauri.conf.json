{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ice Agent",
  "version": "0.1.0",
  "identifier": "com.iceagent.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ice Agent",
        "width": 280,
        "height": 360,
        "minWidth": 220,
        "minHeight": 260,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "resizable": false,
        "center": true,
        "visible": true,
        "focus": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' asset: blob: data: http://127.0.0.1:* http://localhost:*; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* http://127.0.0.1:* http://localhost:* https://api.deepseek.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "icon": [
      "icons/icon.ico"
    ]
  }
}
