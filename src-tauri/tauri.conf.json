{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ice Agent",
  "version": "0.1.0",
  "identifier": "com.iceagent.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ice Agent",
        "width": 420,
        "height": 620,
        "minWidth": 320,
        "minHeight": 420,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "center": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' asset: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": { "wix": { "language": "en-US" } },
    "icon": ["icons/icon.ico"]
  }
}
